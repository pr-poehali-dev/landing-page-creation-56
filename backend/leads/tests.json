{
  "tests": [
    {
      "name": "Создание заявки",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тестовый клиент",
        "phone": "+7 (900) 123-45-67",
        "comment": "Тестовая заявка",
        "duration": 10,
        "days": 30,
        "needVideo": true,
        "totalPrice": 105000,
        "source": "test"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Создание заявки с согласием",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тест Согласие",
        "phone": "+7 (900) 000-00-00",
        "source": "form",
        "consent": true,
        "consentText": "Даю согласие на обработку персональных данных."
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Заявка без имени возвращает ошибку",
      "method": "POST",
      "path": "/",
      "body": {
        "phone": "+7 (900) 123-45-67"
      },
      "expectedStatus": 400
    },
    {
      "name": "Получение списка заявок без пароля запрещено",
      "method": "GET",
      "path": "/",
      "expectedStatus": 403
    },
    {
      "name": "Смена статуса без пароля запрещена",
      "method": "PATCH",
      "path": "/",
      "body": {
        "status": "estimate"
      },
      "expectedStatus": 403
    },
    {
      "name": "Удаление документа без пароля запрещено",
      "method": "DELETE",
      "path": "/?docId=1",
      "expectedStatus": 403
    }
  ]
}